[Unit]
Description=mytunnel tunnel server
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
User=mytunnel
Group=mytunnel
EnvironmentFile=/etc/mytunnel/server.env
ExecStart=/usr/local/bin/tunnel-server
Restart=always
RestartSec=2
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mytunnel
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
