# Copy to .env.production (git-ignored) and fill in. Used by docker-compose.shared.yml
# ---- Step 1: portal on the server IP (no domain yet) ----
APP_NAME=Publish
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                   # php artisan key:generate --show
APP_URL=http://72.61.224.2:8010            # later: https://app.bhargav.run.place
PUBLISH_PORTAL_PORT=8010

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=publish
DB_USERNAME=publish
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

ALLOW_REGISTRATION=true
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG
INTERNAL_API_SECRET=CHANGE_ME_LONG_RANDOM
BASE_DOMAIN=bhargav.run.place
TUNNEL_SERVER_HOST=tunnel.bhargav.run.place
TUNNEL_CONTROL_PORT=47443
PUBLISH_LOCAL_PORT=18443

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Publish
SUPPORT_EMAIL=

# ---- Step 2 (later, needs domain+cert): tunnel-server variables ----
REDIS_ADDR=redis:6379
INTERNAL_API_URL=http://web:8080
