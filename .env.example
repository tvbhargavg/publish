# Copy to .env for local dev. NEVER commit .env or real secrets.
APP_ENV=development            # development | staging | production

# --- Domain / server ---
BASE_DOMAIN=localhost          # change to your real domain later; no code change needed
TUNNEL_SERVER_HOST=localhost
TUNNEL_CONTROL_PORT=4443
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443
ADMIN_LISTEN_ADDR=127.0.0.1:9090   # health/metrics, keep internal
PUBLIC_IP=127.0.0.1

# --- TLS ---
TLS_MODE=none                  # none | file | acme
TLS_CERT_FILE=
TLS_KEY_FILE=
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_DNS_API_TOKEN=change-me

# --- Auth / internal API ---
INTERNAL_API_URL=http://api:8000
INTERNAL_API_SECRET=change-me-long-random
DEV_STATIC_TOKEN=change-me-dev-only   # used only when APP_ENV=development, until Laravel auth (Phase 5)

# --- Datastores ---
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mytunnel
DB_USERNAME=mytunnel
DB_PASSWORD=change-me
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- Limits ---
MAX_BODY_BYTES=10485760
MAX_STREAMS_PER_TUNNEL=100
REQUEST_TIMEOUT=30s
RATE_LIMIT_PER_IP_RPS=50
HEARTBEAT_INTERVAL=15s
TUNNEL_TTL=45s
REVALIDATE_INTERVAL=60s
MAX_TUNNELS_PER_USER=5
ACME_STAGING=false
ACME_STORAGE=./certs
# Serve the Laravel dashboard on app.BASE_DOMAIN through this server (one IP/cert for everything)
DASHBOARD_HOST=
DASHBOARD_UPSTREAM=
